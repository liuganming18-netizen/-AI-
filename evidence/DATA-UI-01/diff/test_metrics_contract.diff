+class NumParseTest(unittest.TestCase):
+    """判据 1：缺失一律 None，绝不用 0 冒充。"""
+
+    def test_blank_and_none_are_missing(self):
+        import metrics_api as m
+        for bad in (None, "", "   ", "abc", float("nan"), float("inf"), "-inf"):
+            self.assertIsNone(m.num(bad), f"{bad!r} 应判缺失，不得返回 0")
+
+    def test_real_zero_is_zero_not_missing(self):
+        """真实的 0 必须保留（不能把 0 也当缺失）——区分「缺失」与「值就是 0」。"""
+        import metrics_api as m
+        self.assertEqual(m.num("0"), 0.0)
+        self.assertEqual(m.num(0), 0.0)
+        self.assertEqual(m.num("0.0000"), 0.0)
+
+    def test_numeric_strings(self):
+        import metrics_api as m
+        self.assertAlmostEqual(m.num("1234.5678"), 1234.5678)
+        self.assertAlmostEqual(m.num(42), 42.0)
+        self.assertIsNone(m.num(True), "布尔不是数值")
+
