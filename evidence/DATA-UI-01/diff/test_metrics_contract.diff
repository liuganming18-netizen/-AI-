+class UnitFormatTest(unittest.TestCase):
+    """判据 6：比例 / 百分比 / 笔数 三种单位分别格式化。"""
+
+    def test_units_differ(self):
+        import metrics_api as m
+        self.assertEqual(m._fmt_unit(94971.0, "笔"), "94,971")
+        self.assertEqual(m._fmt_unit(1.4887263, "倍"), "1.4887")
+        self.assertEqual(m._fmt_unit(59.8188, "%"), "59.8188")
+        self.assertEqual(m._fmt_unit(0.006412, "%/期"), "0.006412")
+        self.assertIsNone(m._fmt_unit(None, "倍"))
+
+    def test_ratio_and_share_are_distinct_fields(self):
+        import metrics_api as m
+        specs = {s["key"]: s for s in m.FIELD_SPECS}
+        self.assertEqual(specs["taker_buy_sell_ratio"]["unit"], "倍")
+        self.assertEqual(specs["taker_buy_share"]["unit"], "%")
+        self.assertNotEqual(specs["taker_buy_sell_ratio"]["basis"],
+                            specs["taker_buy_share"]["basis"])
+
+    def test_funding_current_and_settled_are_separate(self):
+        import metrics_api as m
+        specs = {s["key"]: s for s in m.FIELD_SPECS}
+        self.assertIn("funding_rate_current", specs)
+        self.assertIn("funding_rate_settled", specs)
+        self.assertIn("未结算", specs["funding_rate_current"]["basis"])
+        self.assertIn("已结算", specs["funding_rate_settled"]["basis"])
+
