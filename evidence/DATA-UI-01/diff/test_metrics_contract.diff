+class RotationWindowTest(unittest.TestCase):
+    """判据 4：轮转窗口有界、稳定、全覆盖。"""
+
+    def test_window_is_bounded_and_stable(self):
+        import realtime_collector as rc
+        syms = [f"S{i}USDT" for i in range(60)]
+        w0 = rc.public_extras_ratio_window(syms, 0, n=12)
+        w0b = rc.public_extras_ratio_window(syms, 0, n=12)
+        self.assertEqual(w0, w0b, "同一轮必须稳定（不能随机）")
+        self.assertEqual(len(w0), 12, "窗口大小必须有界")
+        self.assertEqual(len(set(w0)), 12, "窗口内不得重复")
+
+    def test_rotation_covers_every_symbol_once(self):
+        import realtime_collector as rc
+        syms = [f"S{i}USDT" for i in range(60)]
+        n = 12
+        rounds = -(-len(syms) // n)
+        seen = []
+        for r in range(rounds):
+            seen.extend(rc.public_extras_ratio_window(syms, r, n=n))
+        self.assertEqual(sorted(seen), sorted(syms),
+                         f"{rounds} 轮应恰好覆盖全部标的各一次")
+        self.assertEqual(len(seen), len(set(seen)), "不得重复覆盖")
+
+    def test_zero_window_disables_rotation(self):
+        import realtime_collector as rc
+        self.assertEqual(rc.public_extras_ratio_window(["A", "B"], 0, n=0), [])
+        self.assertEqual(rc.public_extras_ratio_window([], 0, n=12), [])
+
+    def test_majors_come_first_in_rotation(self):
+        """主流标的必须排在第 0 轮窗口内，否则最常看的 BTC/ETH 要等好几轮。"""
+        import realtime_collector as rc
+        # 复刻真实顺序：字母序前 N ∪ 主流（主流被追加在末尾）
+        head = [f"S{i:03d}USDT" for i in range(48)]
+        syms = head + [m for m in rc.PUBLIC_EXTRAS_MAJORS if m not in head]
+        order = rc.public_extras_ratio_order(syms)
+        self.assertEqual(order[:len(rc.PUBLIC_EXTRAS_MAJORS)],
+                         list(rc.PUBLIC_EXTRAS_MAJORS)[:len(order[:len(rc.PUBLIC_EXTRAS_MAJORS)])],
+                         "主流标的应排在轮转队首")
+        w0 = rc.public_extras_ratio_window(syms, 0, n=12)
+        self.assertIn("BTCUSDT", w0, "第 0 轮窗口必须包含 BTCUSDT")
+        self.assertIn("ETHUSDT", w0, "第 0 轮窗口必须包含 ETHUSDT")
+        # 轮转仍须覆盖全部，且不重复
+        rounds = -(-len(syms) // 12)
+        seen = []
+        for r in range(rounds):
+            seen.extend(rc.public_extras_ratio_window(syms, r, n=12))
+        self.assertEqual(sorted(seen), sorted(syms))
+
+    def test_pending_symbols_take_front_of_window(self):
+        """上一轮没取齐的标的必须下一轮优先重试，否则要等满一整圈。"""
+        import realtime_collector as rc
+        syms = [f"S{i}USDT" for i in range(60)]
+        base = rc.public_extras_ratio_window(syms, 1, n=12)
+        pending = [syms[50], syms[55]]          # 不在 round=1 窗口内
+        w = rc.public_extras_ratio_window(syms, 1, n=12, pending=pending)
+        self.assertEqual(len(w), 12, "窗口大小仍须有界")
+        self.assertEqual(len(set(w)), 12, "窗口内不得重复")
+        self.assertEqual(w[:2], pending, "pending 必须占据窗口前位")
+        for s in base:
+            if len(w) < 12:
+                break
+        self.assertTrue(set(pending).issubset(set(w)))
+
+    def test_pending_bounded_by_window_size(self):
+        """pending 再多也不能把窗口撑大。"""
+        import realtime_collector as rc
+        syms = [f"S{i}USDT" for i in range(60)]
+        w = rc.public_extras_ratio_window(syms, 0, n=5, pending=syms[:20])
+        self.assertEqual(len(w), 5)
+        self.assertEqual(w, syms[:5], "pending 前 N 个正好填满窗口")
+
+    def test_pending_ignores_unknown_symbols(self):
+        import realtime_collector as rc
+        syms = ["AUSDT", "BUSDT"]
+        w = rc.public_extras_ratio_window(syms, 0, n=2, pending=["ZZZUSDT", "AUSDT"])
+        self.assertEqual(w[0], "AUSDT")
+        self.assertEqual(sorted(w), ["AUSDT", "BUSDT"])
+
+    def test_ratio_blocks_complete_requires_all_three(self):
+        """「处理过」不等于「取齐」：三块必须逐块**真有值**（不能只看 available）。"""
+        import public_market_read as pmr
+        blocks = pmr.RATIO_EXTRA_BLOCKS
+        full = {"long_short": {b: {"available": True, "value": "1.5"} for b in blocks}}
+        self.assertTrue(pmr._ratio_blocks_complete(full))
+        # available:true 但无值 ⇒ 不算取齐（空壳块）
+        shell = {"long_short": {b: {"available": True, "value": None} for b in blocks}}
+        self.assertFalse(pmr._ratio_blocks_complete(shell))
+        for b in blocks:
+            part = {"long_short": {x: {"available": x != b, "value": "1.5"}
+                                   for x in blocks}}
+            self.assertFalse(pmr._ratio_blocks_complete(part),
+                             f"缺 {b} 时不得判为取齐")
+        self.assertFalse(pmr._ratio_blocks_complete({}))
+        self.assertFalse(pmr._ratio_blocks_complete(None))
+
