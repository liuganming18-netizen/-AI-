+class CarryOverTest(unittest.TestCase):
+    """判据 5：继承不等于刷新。"""
+
+    def setUp(self):
+        import public_snapshot
+        self.ps = public_snapshot
+        self.tmp = tempfile.mkdtemp(prefix="snap_test_")
+        self._orig = public_snapshot.SNAP_DIR
+        public_snapshot.SNAP_DIR = __import__("pathlib").Path(self.tmp)
+
+    def tearDown(self):
+        self.ps.SNAP_DIR = self._orig
+        shutil.rmtree(self.tmp, ignore_errors=True)
+
+    def _old_snapshot(self):
+        return {
+            "available": True,
+            "long_short": {
+                "period": "1h",
+                "top_position_long_short_ratio": {
+                    "available": True, "value": "1.5", "event_time": "2026-10-18T00:00:00Z",
+                    "fetched_at": "2026-10-18T00:05:00Z", "period": "1h"},
+                "top_account_long_short_ratio": {
+                    "available": True, "value": "1.9", "event_time": "2026-10-18T00:00:00Z",
+                    "fetched_at": "2026-10-18T00:05:00Z", "period": "1h"},
+                "global_account_long_short_ratio": {
+                    "available": True, "value": "1.7", "event_time": "2026-10-18T00:00:00Z",
+                    "fetched_at": "2026-10-18T00:05:00Z", "period": "1h"},
+                "taker_buy_sell_ratio": {
+                    "available": True, "value": "1.1", "event_time": "2026-10-18T00:00:00Z",
+                    "fetched_at": "2026-10-18T00:05:00Z", "period": "1h"},
+            },
+            "snapshot_refreshed_at": "2026-10-18T00:05:00Z",
+        }
+
+    def test_carry_over_keeps_old_blocks_and_their_timestamps(self):
+        import public_market_read as pmr
+        self.ps.write("binance", "TESTUSDT", self._old_snapshot())
+        skip = {"available": False, "reason": pmr.CORE_SKIP_REASON}
+        new_payload = {
+            "available": True,
+            "long_short": {
+                "period": "1h",
+                "top_position_long_short_ratio": {
+                    "available": True, "value": "1.6", "event_time": "2026-10-18T01:00:00Z",
+                    "fetched_at": "2026-10-18T01:05:00Z", "period": "1h"},
+                "top_account_long_short_ratio": dict(skip),
+                "global_account_long_short_ratio": dict(skip),
+                "taker_buy_sell_ratio": dict(skip),
+            },
+        }
+        merged = pmr._carry_over_ratio("binance", "TESTUSDT", new_payload)
+        ls = merged["long_short"]
+        # 旧值被继承
+        self.assertEqual(ls["top_account_long_short_ratio"]["value"], "1.9")
+        self.assertEqual(ls["global_account_long_short_ratio"]["value"], "1.7")
+        self.assertEqual(ls["taker_buy_sell_ratio"]["value"], "1.1")
+        # 继承块必须保留**自己原本的** fetched_at（继承≠刷新）
+        self.assertEqual(ls["top_account_long_short_ratio"]["fetched_at"],
+                         "2026-10-18T00:05:00Z")
+        self.assertTrue(ls["top_account_long_short_ratio"]["carried_over"])
+        self.assertEqual(sorted(ls["carried_over_blocks"]),
+                         sorted(pmr.RATIO_EXTRA_BLOCKS))
+        # 本轮真正刷新到的块**不得**被旧值覆盖
+        self.assertEqual(ls["top_position_long_short_ratio"]["value"], "1.6")
+        self.assertNotIn("carried_over", ls["top_position_long_short_ratio"])
+
+    def test_core_block_is_carried_when_deferred(self):
+        """核心块被预算推迟时，必须沿用上一轮值，不得把已有值冲成空。
+
+        实测来源：2026-10-18 round 1 首个请求被推迟，BTC 的
+        `top_position_long_short_ratio` 从 1.7772 变 null —— 就是这条缺失。
+        """
+        import public_market_read as pmr
+        self.ps.write("binance", "COREUSDT", self._old_snapshot())
+        skip = {"available": False, "reason": "DeferredRequest: 本地请求预算已用尽"}
+        new_payload = {"available": True, "long_short": {
+            "period": "1h",
+            "top_position_long_short_ratio": dict(skip),
+            "top_account_long_short_ratio": dict(skip),
+            "global_account_long_short_ratio": dict(skip),
+            "taker_buy_sell_ratio": dict(skip),
+        }}
+        ls = pmr._carry_over_ratio("binance", "COREUSDT", new_payload)["long_short"]
+        self.assertTrue(ls["top_position_long_short_ratio"]["available"],
+                        "核心块被推迟时必须继承旧值，不能变空")
+        self.assertEqual(ls["top_position_long_short_ratio"]["value"], "1.5")
+        self.assertEqual(ls["top_position_long_short_ratio"]["fetched_at"],
+                         "2026-10-18T00:05:00Z", "继承必须保留原时间戳")
+        self.assertTrue(ls["top_position_long_short_ratio"]["carried_over"])
+        self.assertIn("top_position_long_short_ratio", ls["carried_over_blocks"])
+
+    def test_oi_block_is_carried_when_empty_shell(self):
+        """持仓量块被写成「available:true 但 amount/usd 全空」时，必须继承旧值。
+
+        实测来源：2026-10-18 某轮 OI 请求被推迟，BTC 快照出现
+        `{"available": true, "amount": null, "usd": null}`，界面从有值变成「—」。
+        """
+        import public_market_read as pmr
+        old = self._old_snapshot()
+        old["open_interest"] = {"available": True, "amount": 93476.938,
+                                "usd": 7650526513.672,
+                                "amount_event_time": "2026-10-18T00:00:00Z",
+                                "fetched_at": "2026-10-18T00:05:00Z"}
+        self.ps.write("binance", "OIUSDT", old)
+        empty = {"available": True, "amount": None, "usd": None, "fetched_at": None}
+        payload = {"available": True, "long_short": {"period": "1h"},
+                   "open_interest": dict(empty)}
+        out = pmr._carry_over_ratio("binance", "OIUSDT", payload)
+        oi = out["open_interest"]
+        self.assertEqual(oi["amount"], 93476.938, "空壳块必须继承旧值")
+        self.assertEqual(oi["fetched_at"], "2026-10-18T00:05:00Z", "继承必须保留原时间戳")
+        self.assertTrue(oi["carried_over"])
+        self.assertTrue(out.get("open_interest_carried_over"))
+
+    def test_block_ok_rejects_empty_shell(self):
+        import public_market_read as pmr
+        self.assertFalse(pmr._block_ok({"available": True, "amount": None, "usd": None}))
+        self.assertFalse(pmr._block_ok({"available": True, "value": ""}))
+        self.assertFalse(pmr._block_ok({"available": False, "value": "1.5"}))
+        self.assertFalse(pmr._block_ok(None))
+        self.assertTrue(pmr._block_ok({"available": True, "value": "1.5"}))
+        self.assertTrue(pmr._block_ok({"available": True, "amount": 0.0}),
+                        "真实的 0 也是值")
+
+    def test_carry_over_no_previous_snapshot(self):
+        import public_market_read as pmr
+        payload = {"available": True, "long_short": {
+            "period": "1h",
+            "top_account_long_short_ratio": {"available": False, "reason": "未取"}}}
+        out = pmr._carry_over_ratio("binance", "NOSUCHUSDT", payload)
+        self.assertFalse(out["long_short"]["top_account_long_short_ratio"]["available"],
+                         "没有旧快照时不得凭空造值")
+
+    def test_fresh_blocks_are_not_overwritten(self):
+        import public_market_read as pmr
+        self.ps.write("binance", "TEST2USDT", self._old_snapshot())
+        fresh = {"available": True, "long_short": {
+            "period": "1h",
+            "top_account_long_short_ratio": {
+                "available": True, "value": "2.2", "fetched_at": "2026-10-18T01:05:00Z"},
+            "global_account_long_short_ratio": {
+                "available": True, "value": "2.3", "fetched_at": "2026-10-18T01:05:00Z"},
+            "taker_buy_sell_ratio": {
+                "available": True, "value": "1.4", "fetched_at": "2026-10-18T01:05:00Z"},
+        }}
+        out = pmr._carry_over_ratio("binance", "TEST2USDT", fresh)
+        self.assertEqual(out["long_short"]["top_account_long_short_ratio"]["value"], "2.2")
+        self.assertNotIn("carried_over", out["long_short"]["top_account_long_short_ratio"])
+
