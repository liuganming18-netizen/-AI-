+class ExchangeCapabilityTest(unittest.TestCase):
+    """判据 2/3：交易所能力门 + 占位值。"""
+
+    def test_okx_lacks_taker_and_trade_count(self):
+        import metrics_api as m
+        for key in ("taker_buy_volume", "taker_buy_quote_volume", "trade_count"):
+            self.assertFalse(m.field_supported("okx", key), f"欧易不应声称支持 {key}")
+        for key in ("taker_buy_volume", "taker_buy_quote_volume", "trade_count",
+                    "volume", "quote_volume"):
+            self.assertTrue(m.field_supported("binance", key), f"币安应支持 {key}")
+
+    def test_okx_trade_count_zero_is_not_reported(self):
+        """欧易 K 线 trade_count=0 是占位值：矩阵里必须判缺失，不能是 0 笔。"""
+        import metrics_api as m
+        try:
+            out = m.build_metrics("okx", "OKB-USDT-SWAP", {"period": ["1h"]})
+        except Exception as exc:                                  # noqa: BLE001
+            self.skipTest(f"离线环境无库/归档：{exc}")
+        rows = {r["key"]: r for r in out.get("fields") or []}
+        if not rows:
+            self.skipTest("无字段（库不可用）")
+        tc = rows.get("trade_count")
+        if tc is None:
+            self.skipTest("矩阵未产出 trade_count 行")
+        self.assertIsNone(tc["value"], "欧易占位 0 不得当真实成交笔数")
+        self.assertIn("上游不支持", tc["missing_reason"] or "")
+
+    def test_okx_oi_uses_base_currency_column(self):
+        """欧易持仓量必须取 oi_ccy（基础币），不能取 open_interest（合约张数）。"""
+        import metrics_api as m
+        try:
+            oi = m.oi_snapshot("okx", "OKB-USDT-SWAP")
+        except Exception as exc:                                  # noqa: BLE001
+            self.skipTest(f"离线环境无库：{exc}")
+        if not oi.get("available"):
+            self.skipTest("无欧易 OI 记录")
+        self.assertIsNotNone(oi.get("qty"))
+        self.assertIsNotNone(oi.get("qty_raw"))
+        # 张数口径与基础币口径相差 100 倍（ctVal=0.01）⇒ 二者不应相等
+        self.assertAlmostEqual(oi["qty_raw"] / oi["qty"], 100.0, delta=1.0,
+                               msg="欧易数量口径应为基础币（oi_ccy），不是合约张数")
