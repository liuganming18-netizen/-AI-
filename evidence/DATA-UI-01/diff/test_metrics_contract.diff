+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""DATA-UI-01 回归：指标字段矩阵的**口径纪律**（离线、零网络、不写正式库）。
+
+覆盖的判据（每条都对应一个曾经的真实坑）：
+  1. `num()` 把空串/None/NaN/inf 判成缺失 ⇒ **绝不返回 0**。
+     （欧易 K 线 `taker_buy_volume` 是空串，`float('')` 会抛错，`or 0` 会变成 0）
+  2. 欧易 `trade_count` 是**占位 0**（原生 K 线不提供），必须判缺失，不能显示「0 笔」。
+  3. 欧易持仓量原始列 `open_interest` 是**合约张数**，数量口径必须取 `oi_ccy`（基础币），
+     否则持仓量放大 100 倍。
+  4. 轮转窗口：有界、稳定序、`ceil(N/window)` 轮覆盖全部标的。
+  5. 轮转继承：本轮未取到的比率块沿用上一轮值，且**保留该块自己的 `fetched_at`**
+     （继承 ≠ 刷新，老值必须仍能显示为过期）。
+  6. 比例 / 百分比 / 笔数 三种单位格式化不同，不混用。
+  7. 加密池分母来自官方分类，INDEX 单列不并入。
+"""
+import json
+import os
+import shutil
+import sys
+import tempfile
+import unittest
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+BACKEND = os.path.dirname(HERE)
+FRAMEWORK = os.path.dirname(BACKEND)
+for _p in (BACKEND, FRAMEWORK):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
