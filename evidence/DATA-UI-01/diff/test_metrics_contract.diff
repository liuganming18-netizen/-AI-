+class PoolScopeTest(unittest.TestCase):
+    """判据 7：分母来自官方分类，INDEX 不并入。"""
+
+    def test_pool_scope_excludes_index_and_non_crypto(self):
+        import metrics_api as m
+        scope = m.pool_scope()
+        if scope.get("error"):
+            self.skipTest(f"分类表不可用：{scope['error']}")
+        self.assertIn("binance", scope)
+        excluded = scope["binance"]["excluded"]
+        self.assertIn("INDEX", excluded, "INDEX 必须单列在排除项里")
+        for label in excluded:
+            self.assertNotIn(label, ("COIN",), "被排除项不得计入分母")
+        self.assertGreater(scope["binance"]["total"], 0)
+        # 分母必须**由表算出**，不是写死的常数
+        self.assertEqual(scope["combined_total"],
+                         scope["binance"]["total"] + scope["okx"]["total"])
