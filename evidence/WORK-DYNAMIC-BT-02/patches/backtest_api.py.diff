+def cm_utc(ms: Optional[int]) -> str:
+    """UTC 毫秒 → `YYYY-MM-DD HH:MMZ`（仅用于文案，不参与任何计算）。"""
+    if not isinstance(ms, int):
+        return "n/a"
+    return datetime.fromtimestamp(ms / 1000, tz=timezone.utc).strftime("%Y-%m-%d %H:%MZ")
+
