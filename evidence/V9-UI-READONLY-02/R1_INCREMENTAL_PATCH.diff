index 42c0ce82..d542c2ed 100644
--- a/test/read-only-ui.test.js
+++ b/test/read-only-ui.test.js
@@ -99,3 +99,72 @@ test('页面资源存在且四主导航可用',async()=>{
     assert.ok(js.includes(key),key);
