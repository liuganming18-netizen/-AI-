+def insert_realtime_forming_bar(db_path: Path, symbol: str, open_time: int, close_time: int,
+                                o: float, h: float, l: float, c: float,
+                                v: float = 2000.0, qv: float = 10000000.0):
+    """写入「执行点当场正在形成的那根 15m 实时 bar」（`realtime_klines`）。
