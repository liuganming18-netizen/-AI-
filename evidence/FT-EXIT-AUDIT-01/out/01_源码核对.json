    "custom_exit 体": "(self, pair: str, trade: Trade, current_time: datetime, current_rate: float,\n                    current_profit: float, **kwargs) -> Optional[str]:\n        # FT-EXIT-01: 取消 240 小时超时及一切主动退出，仅凭初始止损离场\n        return None",
    "含 trigger_2r": false,
    "含 actual_r": false,
    "含 latest_l10": false,
    "含 pair_4h_df 用于止损": false,
    "is_2r_activated 被读取": false,
    "止损段源码": "# FT-EXIT-01: 仅初始止损，取消 2R 跟踪，止损位终生固定，触及才退出\n        if getattr(self, \"stoploss_scheme\", \"S\") == \"P\":\n            # P 组: 固定 20% (成交价 * 0.80)\n            effective_stop = actual_entry * 0.80\n        else:\n            # S 组: 原结构 P0\n            effective_stop = float(cand.initial_stop_price)\n\n        t_id = trade.id or 0\n        if t_id not in self.active_trade_stop_state:\n            self.active_trade_stop_state[t_id] = {\n                \"cand_id\": cand.candidate_id,\n                \"p0\": effective_stop,\n                \"current_stop\": effective_stop,\n                \"is_2r_activated\": False,\n                \"entry_time_ms\": _to_timestamp_ms(trade.open_date_utc)\n            }\n\n        if current_rate <= effective_stop:\n            return 0.0\n\n        stoploss_ratio = (effective_stop - current_rate) / current_rate\n        return float(stoploss_ratio)"
  },
