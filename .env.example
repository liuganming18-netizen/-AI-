# 复制到代码树外的本机配置文件，并填入已存在的权威路径。
# 本模板是 shell 环境文件；server.js 不自动读取 .env。
# 不移动或复制原始行情，不指向未知/新建的空数据库。
export PORT=3010
export GM_DATA_API_URL=http://127.0.0.1:8790
export WEB_READONLY=1
export MARKET_TAIL_FETCH=0
export MARKET_DB="/absolute/existing/market_v2.sqlite3"
export MARKET_ARCHIVE="/absolute/existing/parquet"

# 必须在新代码目录之外。以下路径仅为占位示例。
export WX_STATE_ROOT="/absolute/external/project-state"
export EVENT_TREND_RUNS_DIR="$WX_STATE_ROOT/current/runs"
export OI_RESONANCE_RUNS_DIR="$EVENT_TREND_RUNS_DIR"
export FRAME_FIT_REGISTRY="$WX_STATE_ROOT/registry"
export WX_PROVENANCE_HOME="$WX_STATE_ROOT/provenance"
export BT_RUN_LOG="$WX_STATE_ROOT/logs/backtest_runs.log"

# 历史运行归档放到独立父目录，如 $WX_STATE_ROOT/archive/legacy-runs。
# 不放到 current/runs_old 等同级 runs* 路径；旧索引会扫描这些目录。
# 本文件不创建/迁移登记库，不授予候选运行资格，不启动网关或回测。
